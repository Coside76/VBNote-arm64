name: Sync Upstream

on:
  schedule:
    # Runs daily at midnight UTC
    - cron: '0 0 * * *'
  # Allows you to manually trigger a sync via the Actions tab anytime
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Sync with Upstream
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          
          # Add upstream remote
          git remote add upstream https://github.com/highenergymagic/VBNote.git
          git fetch upstream
          
          # Merge upstream changes into your main branch
          git checkout main
          git merge upstream/main --no-edit || git merge --abort
          
          # Push updated code back to your fork
          git push origin main
